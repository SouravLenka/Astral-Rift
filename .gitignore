# Ignore Unity generated files
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
UserSettings/

# Ignore crash reports
sysinfo/

# Ignore auto-generated files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db
*.pidb.*
*.DS_Store

# Ignore Unity cache server
/[Cc]ache/**

# Ignore package manager folders
Packages/packages-lock.json

# Ignore local environment files
.vscode/
.idea/
*.swp
*.tmp

# Ignore build artifacts
*.apk
*.aab
*.xcodeproj

# Ignore asset store tools
Assets/AssetStoreTools*

# Godot editor/import/cache files
GodotClient/.godot/
GodotClient/.godot/

# Godot C# generated project files and local build output
GodotClient/.mono/
GodotClient/bin/
GodotClient/obj/
GodotClient/*.sln
GodotClient/*.csproj.user

# Godot local editor state and generated metadata
*.godot-editor
